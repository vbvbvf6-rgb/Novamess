# Tracked inventory of supported environment variables.
# Copy values into Replit Secrets or H1Cloud server environment settings.
# Never put real passwords, tokens, private keys, or connection strings here.

# Required by the API server
DATABASE_URL=
JWT_SECRET=
SESSION_SECRET=

# Same-origin full-stack deployment: leave VITE_API_URL empty.
# Set this only when the frontend and API are hosted on different origins.
VITE_API_URL=
PORT=
BASE_PATH=/
NODE_ENV=production
LOG_LEVEL=info

# Push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
FIREBASE_SERVICE_ACCOUNT=

# TURN configuration for calls (one provider is enough)
TURN_URL=
TURN_USER=
TURN_CRED=
METERED_API_KEY=
METERED_APP_URL=
XIRSYS_IDENT=
XIRSYS_SECRET=
XIRSYS_CHANNEL=aura

# S3-compatible storage — all five required to offload media from Postgres
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=
S3_REGION=auto

# Email — configure one provider only
MAIL_FROM=
MAIL_FROM_NAME=Nova
ELASTICEMAIL_API_KEY=
BREVO_API_KEY=
RESEND_API_KEY=
MAILERSEND_API_KEY=
MAILJET_API_KEY=
MAILJET_API_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional integrations / split deployments
DEEP_SEEK=
ALLOWED_ORIGINS=
SELF_URL=
DISABLE_BOTS=
FRONTEND_PORT=
VITE_DEV_SERVER_PORT=
